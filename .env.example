# Supabase (public values — safe in the browser, protected by RLS)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Square — public (safe in the browser)
VITE_SQUARE_APP_ID=
VITE_SQUARE_LOCATION_ID=
# Square — SERVER ONLY (never expose to the client; set in Vercel env, never in code)
SQUARE_ACCESS_TOKEN=
SQUARE_ENVIRONMENT=sandbox

# NOTE: the Content-Security-Policy in vercel.json is a STARTER for the Square
# Web Payments SDK (vercel.json can't hold comments). Before launch, verify the
# allowed domains against Square's current "Web Payments SDK CSP" docs and
# tighten where possible.
